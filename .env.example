# Absolute host path of the target Git checkout or feature workspace. Mounted into
# the container at the same path (Claude's per-project state and the e2e
# docker.sock stack both depend on host==container paths).
CODEBOT_REPO_PATH=
# Target type is automatic: root .git (file or directory) means single repo;
# otherwise the target is a workspace containing child repositories.
# Every file and child repository within a workspace is writable by the bot.
# Optional JSON manifest inside the workspace: first-level repository exclusions,
# base_branches overrides, shared_inputs, checks, and explicit Docker mapping.
CODEBOT_WORKSPACE_MANIFEST=
# Self-healing: off (legacy), observe, propose (manual promotion), auto.
# Initial auto scope: reproducible Python defects; no dependencies, live data,
# approval changes or automatic pushes. Requires rebuilding the supervisor image.
CODEBOT_SELF_HEAL=off
# Where the backlog lives: "gdoc" (default), "github" or "jira".
CODEBOT_TASK_SOURCE=gdoc
# Google Doc id of the improvements backlog. Required when CODEBOT_TASK_SOURCE=gdoc.
CODEBOT_DOC_ID=
# GitHub Projects v2 board, when CODEBOT_TASK_SOURCE=github: the project URL
# (https://github.com/orgs/<owner>/projects/<n>), or owner and number separately.
# Tasks are the board's cards backed by ISSUES of the target repo (draft cards are
# ignored); codebot picks from the pick column(s), moves cards to "In progress" /
# "In review" / "Done", and marks ownership with labels "codebot:<instance>".
CODEBOT_GH_PROJECT_URL=
CODEBOT_GH_PROJECT_OWNER=
CODEBOT_GH_PROJECT_NUMBER=
# Optional: Status column names (must match the board; case-insensitive). Pick
# statuses may be a comma-separated list.
CODEBOT_GH_PROJECT_PICK_STATUSES=Ready
CODEBOT_GH_PROJECT_ACTIVE_STATUS=In progress
CODEBOT_GH_PROJECT_REVIEW_STATUS=In review
CODEBOT_GH_PROJECT_DONE_STATUS=Done
# Optional: "owner/repo" whose issues are the tasks (defaults to the checkout's origin).
CODEBOT_GH_ISSUE_REPO=
# Optional: change the claim/hold issue-label prefix for GitHub Projects.
CODEBOT_GH_LABEL_PREFIX=codebot
# Jira Cloud (only when CODEBOT_TASK_SOURCE=jira): an account email + API token,
# project key and real workflow STATUS names (not board-column names).
# The project key is the short prefix of an issue key: ENG in ENG-42.
# Find it in an issue URL (.../browse/ENG-42) or Jira Project settings.
# It is not the full project name or a UUID; its length is not fixed.
CODEBOT_JIRA_URL=
CODEBOT_JIRA_PROJECT_KEY=
CODEBOT_JIRA_EMAIL=
# Create an API token for this Atlassian account at:
# https://id.atlassian.com/manage-profile/security/api-tokens
CODEBOT_JIRA_API_TOKEN=
# Required: an opt-in label added to Jira issues Coderbot may pick, e.g.
# codebot-ready. An eligible issue needs this label AND the pick status.
CODEBOT_JIRA_PICK_LABEL=
# scripts/setup.sh fetches the project's real workflow statuses and presents
# dropdowns for these four mappings (numbered options in --text mode).
CODEBOT_JIRA_PICK_STATUS=Ready
CODEBOT_JIRA_ACTIVE_STATUS=In progress
CODEBOT_JIRA_REVIEW_STATUS=In review
CODEBOT_JIRA_DONE_STATUS=Done
CODEBOT_JIRA_ISSUE_TYPE=Task
# Activity trail: at every milestone the bot posts a note (message body included) on
# the backlog item — an issue comment on GitHub, one comment thread per task on the
# Google Doc (needs the full Drive scope: re-run scripts/setup_oauth.py on installs
# created before this option). "off" disables it.
CODEBOT_ACTIVITY_TRAIL=on
# Optional: when the target repo has no "Code Review" GitHub Actions workflow, codebot
# seeds a backlog item asking for one. "off" stops seeding that item (useful when PR
# review already happens some other way).
CODEBOT_SELF_HEAL_CODE_REVIEW=on
# Optional: project name used in prompts (defaults to the repo dir name).
CODEBOT_PROJECT_NAME=
# PAT with "repo" scope; add the "project" scope when CODEBOT_TASK_SOURCE=github
# (read:project alone cannot move cards).
GH_TOKEN=
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
# Coding CLI: "claude" (default) or "opencode".
CODEBOT_AGENT=claude
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: defaults to claude-fable-5 / medium when empty.
CLAUDE_MODEL=
CLAUDE_EFFORT=
# Optional: model used when CLAUDE_MODEL runs out of usage credits (HTTP 429).
# Defaults to claude-opus-5; set to an empty value to disable the fallback.
CLAUDE_FALLBACK_MODEL=
CLAUDE_FALLBACK_COOLDOWN_SECONDS=
# Required when CODEBOT_AGENT=opencode. Credentials are stored privately in
# data/opencode/ by scripts/setup.sh, not in this file.
OPENCODE_PROVIDER=
OPENCODE_MODEL=
# Optional GPT thinking/reasoning effort: none, minimal, low, medium, high, xhigh.
# Low favors speed; higher levels reason longer. Availability depends on model/provider.
# Empty preserves OpenCode defaults. Interactive setup: Agent > OPENCODE_EFFORT.
OPENCODE_EFFORT=
# Independently select email (default) or Slack conversations.
CODEBOT_COMM_CHANNEL=email
# Email mode: first address receives messages; mail from any listed address is
# trusted (replies, approvals and commands). Not required for Slack.
CODEBOT_USER_EMAIL=
# Slack mode: a dedicated Slack app per instance, with Socket Mode enabled and
# subscriptions to public-channel messages. The bot must join this public channel.
CODEBOT_SLACK_CHANNEL_ID=
CODEBOT_SLACK_BOT_TOKEN=
CODEBOT_SLACK_APP_TOKEN=
# Optional: only bullets under this heading in the backlog doc are pickable (e.g.
# "New:"). Empty = every top-level bullet in the doc.
CODEBOT_DOC_SECTION=
# Optional: hand-picked instance name ([a-z0-9-]); tags email subjects, branches and
# mailbox commands ("ABORT <instance>"). Defaults to a generated id persisted in
# data/instance_id.
CODEBOT_INSTANCE=
# Optional: host/container data directory override; ensure the bind mount matches.
CODEBOT_DATA_DIR=
CODEBOT_LOG_LEVEL=DEBUG
# Optional: maximum verification/internal-review repair rounds (defaults to 3).
CODEBOT_QUALITY_GATE_MAX_ROUNDS=3
# Optional: a suite that executed 0 tests (or skipped them all) is always reported as such.
# "on" also fails the final gate for checks the agent declared in its CHECK_PLAN; suites
# the bot discovers by itself are never failed for being empty (defaults to off).
CODEBOT_EMPTY_SUITE_FAILS=off
# Optional: let the agent ask for a credential it is missing (e.g. a third-party API key
# for live tests). You choose: send it through a one-time PrivateBin page the bot opens
# (Docker + outbound SSH to localhost.run), continue without it (dependent checks are
# reported as skipped), or pause. Received values live only in data/secrets (0600) for
# CODEBOT_SECRET_TTL_SECONDS and are injected into the agent and check environments.
CODEBOT_CREDENTIAL_REQUESTS=off
# Optional: your own PrivateBin instances whose links are also accepted (comma-separated).
CODEBOT_PRIVATEBIN_INSTANCES=
CODEBOT_PRIVATEBIN_IMAGE=privatebin/nginx-fpm-alpine:2.0.6
CODEBOT_PRIVATEBIN_TTL_SECONDS=3600
CODEBOT_SECRET_TTL_SECONDS=14400
# Optional: maximum OpenSpec archive repair rounds (defaults to 3).
CODEBOT_ARCHIVE_MAX_ROUNDS=3
# Optional: consecutive failures of one state before codebot stops retrying and emails
# you (WAIT_STUCK; defaults to 5), and consecutive question round-trips per phase
# before the same escalation (defaults to 8).
CODEBOT_MAX_STATE_FAILURES=5
CODEBOT_QUESTION_MAX_ROUNDS=8
# Optional: consecutive merge-conflict resolution attempts on one PR before escalating
# (defaults to 3).
CODEBOT_CONFLICT_MAX_ROUNDS=3
# Optional tuning (defaults shown). Timeouts in seconds.
CODEBOT_POLL_INTERVAL=120
CODEBOT_AGENT_TIMEOUT=7200
# Legacy fallback only: prefer CODEBOT_AGENT_TIMEOUT for new configurations.
CODEBOT_CLAUDE_TIMEOUT=
CODEBOT_E2E_TIMEOUT=3600
CODEBOT_E2E_MAX_ROUNDS=5
CODEBOT_SUBPROCESS_TIMEOUT=120
CODEBOT_REVIEW_WAIT_TIMEOUT=2700
CODEBOT_REVIEW_MAX_ROUNDS=3
CODEBOT_PR_THREAD_MAX_ROUNDS=3
CODEBOT_MAX_ATTACH_BYTES=23068672
CODEBOT_SLACK_MAX_ATTACH_BYTES=104857600
# Evidence videos (the stitched Playwright mp4) are uploaded to Google Drive and
# linked from the PR email and the activity trail instead of attached. "off", or a
# failed upload, attaches the file instead (subject to the cap above).
CODEBOT_EVIDENCE_UPLOAD=on
# Optional: Drive folder id that receives the videos. Empty: a "Codebot evidence"
# folder is found or created at the root of the bot account's My Drive.
CODEBOT_DRIVE_FOLDER_ID=
# Delivery always inherits existing folder permissions; no permissions are created.
# Legacy settings below are retained for compatibility and do not grant access.
CODEBOT_DRIVE_SHARE_MODE=inherited
CODEBOT_DRIVE_REVIEWERS=
# Optional: one short reminder for an unanswered decision after 24h; no working pings.
# One reminder per unchanged decision. "off" disables reminders.
CODEBOT_PING_SCHEDULE=24h
# Optional: the compose file e2e/run.sh brings up, torn down by codebot after a
# timed-out run (relative to e2e/; skipped when absent).
CODEBOT_E2E_COMPOSE_FILE=docker-compose.e2e.yaml
# Optional: liveness. The tick loop touches data/heartbeat while a tick is younger than
# CODEBOT_HEARTBEAT_MAX_TICK (defaults to the agent timeout + 15 min); healthcheck.sh
# reports unhealthy past CODEBOT_HEARTBEAT_STALE seconds (360) and kills the container
# past CODEBOT_HEARTBEAT_HARD (600) so `restart: unless-stopped` restarts it.
CODEBOT_HEARTBEAT_MAX_TICK=
CODEBOT_HEARTBEAT_STALE=360
CODEBOT_HEARTBEAT_HARD=600
CODEBOT_OPENCODE_TRANSPORT=http
CODEBOT_UTILITY_TIMEOUT=30
CODEBOT_LOCAL_TOOL_TIMEOUT=200
CODEBOT_SUBAGENT_TIMEOUT=600
CODEBOT_PROVIDER_TIMEOUT=180
CODEBOT_DETERMINISTIC_CHECKS=on
CODEBOT_CONTEXT_TOKEN_BUDGET=80000
CODEBOT_OPENCODE_ROLE_MODELS={}
CODEBOT_OPENCODE_ROLE_EFFORTS={}
CODEBOT_ARTIFACT_MANIFEST=
# Plugin-level parallelism; primary sessions only, no nested delegation.
# Independent units only, exclusive file ownership. Queue wait is bounded by
# CODEBOT_LOCAL_TOOL_TIMEOUT; delegation failures fall back to direct work.
CODEBOT_MAX_SUBAGENTS=3
# Optional: project-specific runtime facts prepended to every working prompt (how to
# run the tests, what is NOT available in the container...). One fact per line; the
# file data/environment.md is used when this is unset.
CODEBOT_ENVIRONMENT_NOTES=
# Optional: trunk branch codebot syncs from, branches off of, opens PRs against, and
# resets to on abort (defaults to "main").
CODEBOT_BASE_BRANCH=main
# Advanced managed runtime path overrides. Normally keep these empty.
CODEBOT_SUPERPOWERS_PLUGIN_DIR=
# Caveman mode for the selected coding harness. ONLY exact lowercase true enables;
# missing, empty, TRUE, yes, 1, or any other value disables. Setup: Agent > Usar Caveman.
USE_CAVEMAN=false
CODEBOT_BRIDGE_PLUGIN_DIR=
CODEBOT_OPENSPEC_SKILLS_DIR=
# Optional host/container Claude config override.
CLAUDE_CONFIG_PATH=
# Optional: only needed if the target repo has its own .claude/settings.json with an
# "apiKeyHelper" that reads this variable. Claude Code always tries apiKeyHelper before
# CLAUDE_CODE_OAUTH_TOKEN, with no fallback if it fails/is empty — so a target repo's own
# apiKeyHelper convention silently breaks codebot's OAuth auth unless this is set to a
# real key from https://console.anthropic.com/ (billed per-token, separate from your
# subscription plan). Leave blank if the target repo has no such setting.
CLAUDE_API_KEY=
