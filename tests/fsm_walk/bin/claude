#!/usr/bin/env python3
"""Fake `claude -p`: a well-behaved agent for the FSM walk (tests/test_fsm_walk.py).

It recognises each phase prompt, edits the fixture repo the way a real agent would,
and prints the CLI's `--output-format json` envelope. Every call is logged to
$WALK_DIR/claude.log; an unrecognised prompt exits 1 so the walk names it."""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

argv = sys.argv[1:]
after = argv[argv.index("-p") + 1] if "-p" in argv and argv.index("-p") + 1 < len(argv) else "--"
raw_prompt = sys.stdin.read() if after.startswith("--") else after  # coderbot sends it on stdin
prompt = " ".join(raw_prompt.split())  # markers must not depend on prompt line wrapping
utility = "--tools" in argv and argv[argv.index("--tools") + 1] == ""
session = argv[argv.index("--resume") + 1] if "--resume" in argv else f"ses-{os.getpid()}"
walk = Path(os.environ["WALK_DIR"])
slug = os.environ["WALK_SLUG"]
change = Path("openspec/changes") / slug


def git(*args):
    subprocess.run(["git", *args], check=True, capture_output=True)


def tasks_count():
    text = (change / "tasks.md").read_text()
    done, total = len(re.findall(r"- \[x\]", text)), len(re.findall(r"- \[[ x]\]", text))
    return f"{done}/{total}"


PROPOSAL = """## Why
Users need a greeting.

## What Changes
- Add `greet(name)` returning `Hello, <name>!`.

## Capabilities
### New Capabilities
- `greeting`: greet a person by name.

## Impact
- New module `greet.py`.
"""
SPEC = """## ADDED Requirements

### Requirement: Greeting
The system SHALL greet a person by name.

#### Scenario: Named greeting
- **WHEN** `greet("Ada")` is called
- **THEN** it returns `Hello, Ada!`
"""


def respond(answer):
    """Utility calls answer text; working calls (--json-schema) return structured_output
    like the real CLI, with the summary as the text result."""
    envelope = {"type": "result", "subtype": "success", "session_id": session, "is_error": False}
    if isinstance(answer, dict):
        envelope.update(result=answer["summary"], structured_output={"status": "done", **answer})
    else:
        envelope["result"] = answer
    print(json.dumps(envelope))
    sys.exit(0)


def phase():
    if utility:
        rules = [("Identify the language", {"language": "English"}),
                 ("Classify an authorized task-thread message",
                  {"intent": "answer", "resolves_pending_question": True, "requested_action": None,
                   "action_depends_on_change": False, "inputs": []}),
                 ("replied to the proposal-review", {"action": "approve", "feedback": ""}),
                 ("replied to the pull-request review", {"action": "merge", "force": True, "feedback": ""}),
                 ("architecture review", {"decisions": []}),
                 ("title for a GitHub pull request", {"title": "Add greeting"})]
        for marker, answer in rules:
            if marker in prompt:
                return "utility:" + marker, json.dumps(answer)
        return None, None
    if "explore this backlog item" in prompt:
        return "EXPLORE", {"summary": "Exploration complete: a small pure function plus a unit test.",
                           "classification": "bounded", "pr_title": "Add greeting"}
    if "turn the exploration into OpenSpec change" in prompt:
        (change / "specs/greeting").mkdir(parents=True, exist_ok=True)
        (change / "proposal.md").write_text(PROPOSAL)
        (change / "design.md").write_text("## Context\nA pure function; no state.\n")
        (change / "tasks.md").write_text("## 1. Greeting\n\n- [ ] 1.1 Add greet() with a unit test\n")
        (change / "specs/greeting/spec.md").write_text(SPEC)
        return "PROPOSE", {"summary": PROPOSAL}
    if "The user approved OpenSpec change" in prompt:
        Path("greet.py").write_text('def greet(name):\n    return f"Hello, {name}!"\n')
        Path("test_greet.py").write_text(
            "import unittest\nfrom greet import greet\n\n\nclass Greet(unittest.TestCase):\n"
            "    def test_named(self):\n        self.assertEqual(greet('Ada'), 'Hello, Ada!')\n")
        tasks = change / "tasks.md"
        tasks.write_text(tasks.read_text().replace("- [ ]", "- [x]"))
        git("add", "-A")
        git("commit", "-qm", "Add greet() with a unit test")
        plan = {"version": 1, "checks": [{"id": "unit", "argv": ["python3", "-m", "unittest", "-q"],
                                          "cwd": ".", "scope": "focused", "inputs": ["greet.py", "test_greet.py"]}]}
        return "IMPLEMENT", {"summary": "Implemented greet() test-first.", "checks": plan["checks"]}
    if "verify OpenSpec change" in prompt:
        gate = {"status": "pass", "commands": ["python3 -m unittest: pass"], "preexisting": [],
                "openspec": "pass", "tasks": tasks_count()}
        return "VERIFY", {"summary": "All checks pass.", "verification": gate}
    if "read-only reviewer of OpenSpec change" in prompt:
        review = {"critical": 0, "important": 0, "tests": ["python3 -m unittest: pass"]}
        return "INTERNAL_REVIEW", {"summary": "Fresh review found nothing to fix.", "review": review}
    return None, None


name, text = phase()
with (walk / "claude.log").open("a") as log:
    system = argv[argv.index("--append-system-prompt") + 1] if "--append-system-prompt" in argv else ""
    log.write(json.dumps({"phase": name, "utility": utility, "resume": "--resume" in argv,
                          "chars": len(prompt), "system_chars": len(system),
                          "schema": "--json-schema" in argv, "settings": "--settings" in argv}) + "\n")
if name is None:
    (walk / f"unknown-prompt-{os.getpid()}.txt").write_text(raw_prompt)
    print(json.dumps({"type": "result", "subtype": "error", "is_error": True,
                      "result": "fake claude: unrecognised prompt"}))
    sys.exit(1)
respond(text)
